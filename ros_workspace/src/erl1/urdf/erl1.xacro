<?xml version='1.0'?>
<robot name="erl1" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Properties -->
    <xacro:property name="length_wheel" value="0.05" />
    <xacro:property name="radius_wheel" value="0.1" />

    <!-- Macros -->
    <xacro:macro name="default_inertial" params="mass">
        <inertial>
            <mass value="${mass}" />
            <origin rpy="0 1.5707 1.5707" xyz="0 0 0"/>
            <inertia
                ixx="${mass*(3*radius_wheel**2+length_wheel**2)/12}" ixy="0" ixz="0"
                iyy="${mass*(3*radius_wheel**2+length_wheel**2)/12}" iyz="0"
                izz="${mass*radius_wheel**2/2}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="wheel_geometry">
        <geometry>
            <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
        </geometry>
    </xacro:macro>

    <material name="blue">
        <color rgba="0.203125 0.23828125 0.28515625 1.0"/>
    </material>

    <material name="green">
        <color rgba="0.0 1.0 0.0 1.0"/>
    </material>

    <material name="red">
        <color rgba="1.0 0.0 0.0 1.0"/>
    </material>

    <material name= "orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
    </material>



    <!-- Your Existing Link -->
    <link name="link_chassis">
        <inertial>
            <mass value="5"/>
            <origin rpy="0 0 0" xyz="0 0 0.1"/>
            <inertia ixx="0.0395416666667" ixy="0" ixz="0" iyy="0.106208333333" iyz="0" izz="0.141666666667"/>
        </inertial>
        <collision name="collision_chassis">
            <geometry>
                <box size="0.5 0.3 0.07"/>
            </geometry>
        </collision>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.5 0.3 0.07"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <!-- caster front -->
        <collision name="caster_front_collision">
            <origin rpy="0 0 0" xyz="0.2 0 -0.05"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>
        <visual name="caster_front_visual">
            <origin rpy="0 0 0" xyz="0.2 0 -0.05"/>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </visual>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
        <xacro:default_inertial mass="5.0"/>
        <collision>
            <origin xyz="0 0 0" rpy="0 0.1570 1.5707"/>
            <xacro:wheel_geometry/>
        </collision>

        <visual name="left_wheel_visual">
            <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
            <xacro:wheel_geometry/>
            <material name="green"/>
        </visual>
    </link>

    <!-- Right Wheel -->
    <link name="right_wheel">
        <xacro:default_inertial mass="5.0"/>
        <collision>
            <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
            <xacro:wheel_geometry/>
        </collision>
        <visual name="right_wheel_visual">
            <origin xyz="0 0 0" rpy="0 1.5707 1.5707"/>
            <xacro:wheel_geometry/>
            <material name="blue"/>
        </visual>
    </link>

    <!-- Base -->
    <link name="base">
        <inertial>
            <mass value="2.0"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.09 0.09"/>
            </geometry>
        </collision>
        <visual name="base_visual">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.09 0.09 0.09"/>
            </geometry>
            <material name="orange"/>
        </visual>
    </link>

    <!-- Joints Right Wheel -->
    <joint type="continuous"
        name="right_wheel_joint">
        <origin xyz="-0.1 -0.15 0" rpy="0 0 0"/>
        <child link="right_wheel"/>
        <parent link="link_chassis"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>

    <!-- Joints Left Wheel -->
    <joint type="continuous"
        name="left_wheel_joint">
        <origin xyz="-0.1 0.15 0" rpy="0 0 0"/>
        <child link="left_wheel"/>
        <parent link="link_chassis"/>
        <axis xyz="0 1 0"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>


    <!-- Base -->
    <joint type="continuous"
        name="base_joint">
        <origin xyz="0 0 0.08" rpy="0 0 0"/>
        <child link="base"/>
        <parent link="link_chassis"/>
        <axis xyz="0 0 1"/>
        <limit effort="100" velocity="10"/>
        <dynamics damping="1.0" friction="1.0"/>
    </joint>
</robot>